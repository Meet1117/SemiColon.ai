@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}

<h1 class="auth-title">Set a new password</h1>
<p class="auth-subtitle">Choose a strong password for your account.</p>

<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Token" />

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" placeholder="••••••••" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="••••••••" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary">Reset password</button>
</form>
